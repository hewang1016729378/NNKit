{
  "name": "NNKit",
  "version": "1.1.0",
  "summary": "Leigod NNKit Tools",
  "description": "TODO: Add long description of the pod here.",
  "homepage": "https://github.com/ly/NNKit",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "nn": "nn.com"
  },
  "source": {
    "git": "http://git.leigod.top/root/nnkit.git",
    "tag": "1.1.0"
  },
  "platforms": {
    "ios": "12.0"
  },
  "prefix_header_contents": "# if __has_include(<NNKit/NNKit-Swift.h>)\n    #import <NNKit/NNKit-Swift.h>\n#else\n    #import NNKit-Swift.h\"\n#endif",
  "static_framework": true,
  "dependencies": {
    "SnapKit": [],
    "BRPickerView": [],
    "PanModal": [],
    "RxSwift": [],
    "RxSwiftExt": [],
    "RxCocoa": [],
    "YYText": [
      "~> 1.0.7"
    ]
  },
  "subspecs": [
    {
      "name": "Classes",
      "subspecs": [
        {
          "name": "Base",
          "source_files": "NNKit/Classes/Base/**/*"
        },
        {
          "name": "Extensions",
          "source_files": "NNKit/Classes/Extensions/**/*"
        },
        {
          "name": "Shared",
          "source_files": "NNKit/Classes/Shared/**/*"
        },
        {
          "name": "Utils",
          "source_files": "NNKit/Classes/Utils/**/*"
        },
        {
          "name": "Views",
          "source_files": "NNKit/Classes/Views/**/*"
        },
        {
          "name": "OCFiles",
          "source_files": "NNKit/Classes/OCFiles/**/*"
        }
      ]
    },
    {
      "name": "Assets",
      "resources": "NNKit/Assets/NNKitBundle.bundle"
    }
  ]
}
